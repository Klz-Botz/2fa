# ============================================================
# KLZXIDGH 2FA — .htaccess
# ============================================================

Options -Indexes
ServerSignature Off

# ---------- Default Document ----------
DirectoryIndex home.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ---------- Force HTTPS ----------
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # ---------- Skip file/folder yang benar-benar ada ----------
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ---------- URL Token 2FA (/2fa-XXXX) ----------
    RewriteRule ^2fa-([A-Za-z0-9_-]+)/?$ home.html [L]
    RewriteRule ^2fa/([A-Za-z0-9_-]+)/?$ home.html [L]
    RewriteRule ^2fa/?$ home.html [L]

    # ---------- Redirect Home.html ke root (/) ----------
    RewriteCond %{THE_REQUEST} \s/+home\.html[\s?] [NC]
    RewriteRule ^ / [R=301,L,NE]

    # ---------- Redirect Ganti-Akun.html ke /ganti-akun ----------
    RewriteCond %{THE_REQUEST} \s/+ganti-akun\.html[\s?] [NC]
    RewriteRule ^ /ganti-akun [R=301,L,NE]

    # ---------- URL Bersih untuk halaman lain (.html dihapus) ----------
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ---------- Security Headers ----------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>

# ---------- Izinkan Gambar (Untuk Embed Discord) ----------
<FilesMatch "\.(png|jpg|jpeg|webp|svg|gif|ico)$">
    Require all granted
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "public, max-age=31536000"
</FilesMatch>

# ---------- Blokir File Sensitif ----------
<FilesMatch "^\.(htaccess|htpasswd|git|env|DS_Store)">
    Require all denied
</FilesMatch>

<FilesMatch "\.(md|json|lock|log|sql|bak|old|swp|ini|conf|txt)$">
    Require all denied
</FilesMatch>

# ---------- Halaman Error ----------
ErrorDocument 403 /home.html
ErrorDocument 404 /home.html
ErrorDocument 500 /home.html
