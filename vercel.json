{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/ganti-akun",
      "destination": "/ganti-akun.html"
    },
    {
      "source": "/2fa-:token",
      "destination": "/index.html"
    },
    {
      "source": "/2fa/:token",
      "destination": "/index.html"
    }
  ]
}
