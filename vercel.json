{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/home.html"
    },
    {
      "source": "/ganti-akun",
      "destination": "/ganti-akun.html"
    },
    {
      "source": "/2fa-:token",
      "destination": "/home.html"
    },
    {
      "source": "/(.*)",
      "destination": "/home.html"
    }
  ]
}
